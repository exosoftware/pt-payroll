<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--    this is a duplicated file-->
    <record id="hr_salary_complement_pt_view_search" model="ir.ui.view">
        <field name="name">hr.salary.complement.pt.search</field>
        <field name="model">hr.salary.complement.pt</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id" />
                <field name="input_type_id" />
                <field name="description" />
                <field name="company_id" groups="base.group_multi_company" />
                <filter
                    string="Running"
                    name="filter_running"
                    domain="[('state', '=', 'running')]"
                />
                <filter
                    string="Completed"
                    name="filter_completed"
                    domain="[('state', '=', 'completed')]"
                />
                <filter
                    string="Cancelled"
                    name="filter_cancelled"
                    domain="[('state', '=', 'cancelled')]"
                />
                <separator />
                <filter
                    string="Attachments"
                    name="filter_is_attachment"
                    domain="[('is_attachment', '=', True)]"
                />
                <filter
                    string="Salary Complements"
                    name="filter_not_attachment"
                    domain="[('is_attachment', '=', False)]"
                />
                <group>
                    <filter
                        string="Employee"
                        name="group_by_employee"
                        context="{'group_by': 'employee_id'}"
                    />
                    <filter
                        string="Input Type"
                        name="group_by_input_type"
                        context="{'group_by': 'input_type_id'}"
                    />
                    <filter
                        string="Status"
                        name="group_by_state"
                        context="{'group_by': 'state'}"
                    />
                    <filter
                        string="Company"
                        name="group_by_company"
                        context="{'group_by': 'company_id'}"
                        groups="base.group_multi_company"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="hr_salary_complement_pt_view_tree" model="ir.ui.view">
        <field name="name">hr.salary.complement.pt.list</field>
        <field name="model">hr.salary.complement.pt</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id" optional="show" />
                <field name="input_type_id" optional="show" />
                <field name="is_attachment" optional="show" />
                <field name="date_start" optional="show" />
                <field name="date_stop" optional="show" />
                <field name="monthly_value" optional="show" />
                <field name="amount_of_attachment" optional="show" />
                <field name="amount_already_attached" optional="hide" />
                <field name="amount_to_be_attached" optional="hide" />
                <field name="state" optional="show" />
            </list>
        </field>
    </record>

    <record id="hr_salary_complement_pt_view_form" model="ir.ui.view">
        <field name="name">hr.salary.complement.pt.form</field>
        <field name="model">hr.salary.complement.pt</field>
        <field name="arch" type="xml">
            <form string="Salary Complement">
                <header>
                    <button
                        name="action_completed"
                        type="object"
                        string="Completed"
                        invisible="state not in ['running', 'cancelled']"
                    />
                    <button
                        name="action_running"
                        type="object"
                        string="Running"
                        invisible="state not in ['completed', 'cancelled']"
                    />
                    <button
                        name="action_cancelled"
                        type="object"
                        string="cancelled"
                        invisible="state not in ['running']"
                    />
                    <button
                        name="action_refresh_attachment_progress_from_payslips"
                        type="object"
                        string="Refresh From Payslips"
                        class="btn-primary"
                        invisible="not is_attachment or not state == 'running'"
                        help="Updates the attachment progress fields based on amounts found in linked payslip lines (matching the input type code)."
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="running,completed"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            type="object"
                            name="action_open_payslips"
                            class="oe_stat_button"
                            icon="fa-money"
                            id="open_payslips"
                            invisible="not payslip_count"
                        >
                            <field
                                name="payslip_count"
                                widget="statinfo"
                                string="Payslips"
                            />
                        </button>
                        <button
                            type="object"
                            name="action_open_payslips"
                            class="oe_stat_button"
                            icon="fa-money"
                            id="open_payslips"
                            invisible="not attachment_payslip_count "
                        >
                            <field
                                name="attachment_payslip_count"
                                widget="statinfo"
                                string="Payslips"
                            />
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="employee_id" />
                        <h1>
                            <field name="employee_id" readonly="state == 'completed'" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="description" readonly="state == 'completed'" />
                            <field
                                name="is_attachment"
                                readonly="state == 'completed'"
                            />
                            <field
                                name="input_type_id"
                                invisible="is_attachment"
                                readonly="state == 'completed'"
                                domain="[('name', 'not ilike', 'PENHORA')]"
                            />

                            <field
                                name="input_type_id"
                                invisible="not is_attachment"
                                readonly="state == 'completed'"
                                domain="[('name', 'ilike', 'PENHORA')]"
                            />
                            <field
                                name="monthly_value"
                                invisible="is_attachment"
                                readonly="state == 'completed'"
                            />
                            <field
                                name="amount_of_attachment"
                                invisible="not is_attachment"
                                readonly="state == 'completed'"
                            />
                        </group>
                        <group>
                            <field name="date_start" readonly="state == 'completed'" />
                            <field
                                name="date_of_communication_of_attachment"
                                invisible="not is_attachment"
                                required="is_attachment"
                            />
                            <field
                                name="date_stop"
                                invisible="is_attachment"
                                readonly="state == 'completed'"
                            />
                            <field
                                name="amount_already_attached"
                                invisible="not is_attachment"
                            />
                            <field
                                name="amount_to_be_attached"
                                invisible="not is_attachment"
                            />
                        </group>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="hr_salary_complement_pt_action" model="ir.actions.act_window">
        <field name="name">Salary Complement (PT)</field>
        <field name="res_model">hr.salary.complement.pt</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="hr_salary_complement_pt_view_tree" />
        <field name="search_view_id" ref="hr_salary_complement_pt_view_search" />
        <field name="context">{'search_default_filter_running': 1}</field>
    </record>

    <menuitem
        id="menu_hr_salary_complement_pt_action"
        action="hr_salary_complement_pt_action"
        sequence="35"
        parent="hr_payroll.menu_hr_payroll_employees"
    />
</odoo>
