<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_contract_view_form_pt" model="ir.ui.view">
        <field name="name">hr.contract.form.pt</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form" />
        <field name="arch" type="xml">
            <field name="active" position="after">
                <field name="country_code" invisible="1" />
            </field>
            <div name="button_box" position="before">
                <div
                    class="alert alert-warning"
                    role="alert"
                    groups="hr_payroll.group_hr_payroll_user"
                    invisible="country_code != 'PT' or not l10n_pt_scc_remuneration_pending"
                >
                    <field name="l10n_pt_scc_remuneration_pending" invisible="1" />
                    This contract updates permanent remunerations
                    (<field name="l10n_pt_scc_updated_remunerations" readonly="1" />)
                    that were not communicated to Social Security yet.
                </div>
            </div>
            <page name="other" position="after">
                <page
                    string="SS Communication"
                    name="l10n_pt_scc"
                    invisible="country_code != 'PT' or not l10n_pt_scc_active"
                    groups="hr.group_hr_user"
                >
                    <!-- The conditions of the page and of its buttons read
                         these fields, so they have to be part of the form. -->
                    <field name="l10n_pt_scc_active" invisible="1" />
                    <field name="l10n_pt_scc_contracts_checked" invisible="1" />
                    <field name="l10n_pt_scc_can_communicate_hiring" invisible="1" />
                    <field name="l10n_pt_scc_can_change_contract" invisible="1" />
                    <field name="l10n_pt_scc_can_communicate_cessation" invisible="1" />
                    <field name="l10n_pt_scc_cessation_communicated" invisible="1" />
                    <field name="l10n_pt_corporate_body" invisible="1" />
                    <div
                        class="alert alert-info"
                        role="status"
                        invisible="l10n_pt_scc_contracts_checked"
                        groups="hr_payroll.group_hr_payroll_user"
                    >
                        Check the worker at Social Security first: the
                        communications available follow what Social Security
                        holds for the worker.
                    </div>
                    <div class="mb-3" groups="hr_payroll.group_hr_payroll_user">
                        <!-- The communications offered follow the worker's
                             last contracts query: the employment relationship
                             when none is open at Social Security, a contract
                             change when one is, the permanent remunerations
                             whenever the contract updates any of them. -->
                        <button
                            name="action_l10n_pt_scc_communicate_hiring"
                            type="object"
                            string="Communicate Employment Relationship"
                            class="btn-primary me-2"
                            invisible="not l10n_pt_scc_can_communicate_hiring"
                            confirm="The contract will be communicated to Social Security right away as an employment relationship (on the worker's first contract, if Social Security already knows the worker, the permanent remuneration is communicated instead). Continue?"
                        />
                        <!-- A change to the contract Social Security already
                             holds (e.g. the renewal of a fixed term), from
                             the date this contract takes effect. -->
                        <button
                            name="action_l10n_pt_scc_communicate_contract_change"
                            type="object"
                            string="Communicate Contract Change"
                            class="btn-primary me-2"
                            invisible="not l10n_pt_scc_can_change_contract"
                            confirm="This contract will be communicated to Social Security right away as a change to the worker's current contract there. Continue?"
                        />
                        <button
                            name="action_l10n_pt_scc_communicate_remuneration"
                            type="object"
                            string="Communicate Permanent Remuneration"
                            class="btn-primary me-2"
                            invisible="not l10n_pt_scc_contracts_checked or not l10n_pt_scc_remuneration_pending"
                            confirm="The permanent remunerations this contract updates will be communicated to Social Security right away. Continue?"
                        />
                        <!-- The end of the employment relationship Social
                             Security holds open: a contract ending, not one
                             replaced by an update of the contractual
                             conditions (999), a suspension (2xx) or a
                             renewal. -->
                        <button
                            name="action_l10n_pt_scc_communicate_cessation"
                            type="object"
                            string="Communicate Cessation"
                            class="btn-primary me-2"
                            invisible="not l10n_pt_scc_can_communicate_cessation"
                            confirm="The end of the employment relationship will be communicated to Social Security right away. Continue?"
                        />
                        <button
                            name="action_l10n_pt_scc_check_contract"
                            type="object"
                            string="Check at SS"
                            class="btn-secondary"
                        />
                    </div>
                    <group>
                        <group name="l10n_pt_scc_communication">
                            <field
                                name="l10n_pt_scc_contract_at_ss"
                                invisible="l10n_pt_corporate_body"
                            />
                            <field name="l10n_pt_scc_communicated" />
                            <field
                                name="l10n_pt_scc_relationship_state"
                                widget="badge"
                                decoration-info="l10n_pt_scc_relationship_state in ('sent', 'processing')"
                                decoration-success="l10n_pt_scc_relationship_state == 'integrated'"
                                decoration-danger="l10n_pt_scc_relationship_state == 'refused'"
                                invisible="not l10n_pt_scc_relationship_state"
                            />
                            <field
                                name="l10n_pt_scc_relationship_reason"
                                invisible="not l10n_pt_scc_relationship_reason"
                            />
                            <field name="l10n_pt_ss_workplace_code" />
                            <field name="l10n_pt_ss_framework" />
                            <field name="l10n_pt_ss_replaced_worker_niss" />
                        </group>
                        <group
                            name="l10n_pt_scc_cessation"
                            string="Cessation"
                            groups="hr_payroll.group_hr_payroll_user"
                            invisible="not date_end"
                        >
                            <field
                                name="l10n_pt_scc_cessation_reason"
                                readonly="l10n_pt_scc_cessation_communicated"
                            />
                            <field
                                name="l10n_pt_scc_unemployment_communication"
                                readonly="l10n_pt_scc_cessation_communicated"
                            />
                            <field
                                name="l10n_pt_scc_cessation_justification"
                                readonly="l10n_pt_scc_cessation_communicated"
                                invisible="not l10n_pt_scc_unemployment_communication or l10n_pt_scc_cessation_reason not in ('RARC', 'RARD', 'RARE', 'RARR')"
                            />
                            <field
                                name="l10n_pt_scc_cessation_communicated"
                                invisible="not l10n_pt_scc_cessation_communicated"
                            />
                        </group>
                    </group>
                    <group
                        name="l10n_pt_scc_ss_remunerations"
                        string="Permanent Remunerations Registered at Social Security"
                        groups="hr_payroll.group_hr_payroll_user"
                        invisible="not l10n_pt_scc_remunerations_checked_on"
                    >
                        <field name="l10n_pt_scc_remunerations_checked_on" />
                        <field
                            name="l10n_pt_scc_ss_remuneration_ids"
                            nolabel="1"
                            colspan="2"
                        >
                            <tree create="0" delete="0" edit="0">
                                <field name="remuneration_type" />
                                <field name="description" />
                                <field name="start_date" />
                                <field name="end_date" />
                                <field name="value" />
                                <field name="communication_date" optional="show" />
                                <field name="currency_id" column_invisible="1" />
                            </tree>
                        </field>
                    </group>
                    <group
                        name="l10n_pt_scc_ss_contracts"
                        string="Contracts Registered at Social Security"
                        groups="hr_payroll.group_hr_payroll_user"
                        invisible="not l10n_pt_scc_contracts_checked_on"
                    >
                        <field name="l10n_pt_scc_contracts_checked_on" />
                        <!-- One line per contract, with the terms of the
                             information period in force; every period is
                             listed behind the button. -->
                        <field
                            name="l10n_pt_scc_ss_current_contract_ids"
                            nolabel="1"
                            colspan="2"
                        >
                            <tree create="0" delete="0" edit="0">
                                <field name="start_date" />
                                <field name="end_date" />
                                <field name="modality" />
                                <field name="reason" optional="show" />
                                <field name="base_remuneration" />
                                <field name="currency_id" column_invisible="1" />
                                <field name="information_start_date" optional="show" />
                                <field name="period_count" optional="show" />
                                <field name="profession" optional="hide" />
                                <field name="provision_of_work" optional="hide" />
                                <field name="work_percentage" optional="hide" />
                                <field name="weekly_hours" optional="hide" />
                                <field name="work_days" optional="hide" />
                            </tree>
                        </field>
                        <button
                            name="action_l10n_pt_scc_open_ss_contract_periods"
                            type="object"
                            string="Information Periods"
                            class="btn-link"
                            icon="fa-list"
                            colspan="2"
                        />
                    </group>
                </page>
            </page>
            <page name="other" position="inside">
                <group
                    name="info"
                    string="More Information"
                    invisible="country_code != 'PT'"
                >
                    <field
                        name="l10n_pt_reason_for_end_of_contract"
                        required="state == 'cancel'"
                    />
                </group>
            </page>
            <xpath expr="//group[@name='salary_info']">
                <group string="Contract Data" invisible="country_code != 'PT'">
                    <field name="l10n_pt_contract_modality" invisible="1" />
                    <field name="l10n_pt_provision_of_work" />
                    <field name="l10n_pt_contract_reason" />
                </group>
                <group string="Meal Allowance" invisible="country_code != 'PT'">
                    <label
                        for="l10n_pt_meal_allowance_amount"
                        string="Subsidy Amount"
                    />
                    <div class="o_row">
                        <field name="l10n_pt_meal_allowance_amount" widget="monetary" />
                        <span>/ day</span>
                    </div>
                    <field
                        name="l10n_pt_meal_allowance_payment_method"
                        string="Payment Method"
                    />
                    <field name="l10n_pt_hours_to_count_for_daily_meal" />
                    <field
                        name="l10n_pt_meal_allowance_card_no"
                        string="Meal Card No."
                    />
                    <field
                        name="l10n_pt_automatically_processed_meal_allowance"
                        string="Automatically Processed"
                    />
                </group>
                <group string="Holiday Allowance" invisible="country_code != 'PT'">
                    <field
                        name="l10n_pt_holiday_allowance_payment_method"
                        string="Payment Method"
                    />
                    <field
                        name="l10n_pt_holiday_allowance_payment_month"
                        string="Payment Month"
                    />
                        <field
                        name="l10n_pt_holiday_allowance_independent_receipt"
                        string="Independent Receipt"
                        invisible="not l10n_pt_holiday_allowance_payment_method or l10n_pt_holiday_allowance_payment_method == 'twelfths_to_100'"
                    />
                    </group>
                    <group
                    string="Christmas Allowance"
                    invisible="country_code != 'PT'"
                >
                        <field
                        name="l10n_pt_christmas_allowance_payment_method"
                        string="Payment Method"
                    />
                    <field
                        name="l10n_pt_christmas_allowance_payment_month"
                        string="Payment Month"
                    />
                        <field
                        name="l10n_pt_christmas_allowance_independent_receipt"
                        string="Independent Receipt"
                        invisible="not l10n_pt_christmas_allowance_payment_method or l10n_pt_christmas_allowance_payment_method == 'twelfths_to_100'"
                    />
                    </group>
                    <group string="Overtime Work" invisible="country_code != 'PT'">
                        <field
                        name="l10n_pt_overtime_first_hour_rate"
                        string="Overtime First Hour"
                        widget="percentage"
                    />
                    <field
                        name="l10n_pt_overtime_remaining_hours_rate"
                        string="Overtime Remaining Hours"
                        widget="percentage"
                    />
                    <field
                        name="l10n_pt_overtime_rest_days_rate"
                        string="Overtime Rest Days"
                        widget="percentage"
                    />
                    <field
                        name="l10n_pt_overtime_workdays_rate"
                        string="Overtime Workdays"
                        widget="percentage"
                    />
                    <field
                        name="l10n_pt_overtime_holidays_rate"
                        string="Overtime Holidays"
                        widget="percentage"
                    />
                    <field
                        name="l10n_pt_overtime_saturday_and_holidays_rate"
                        string="Overtime Saturday and Holidays"
                        widget="percentage"
                    />
                    <field
                        name="l10n_pt_overtime_sunday_rate"
                        string="Overtime Sunday"
                        widget="percentage"
                    />
                    </group>
                    <group
                    string="Overtime Work From 100º Hour"
                    invisible="country_code != 'PT'"
                >
                        <field
                        name="l10n_pt_overtime_first_hour_rate_100"
                        string="Overtime First Hour"
                        widget="percentage"
                    />
                        <field
                        name="l10n_pt_overtime_remaining_hours_rate_100"
                        string="Overtime Remaining Hours"
                        widget="percentage"
                    />
                        <field
                        name="l10n_pt_overtime_rest_days_rate_100"
                        string="Overtime Rest Days"
                        widget="percentage"
                    />
                        <field
                        name="l10n_pt_overtime_workdays_rate_100"
                        string="Overtime Workdays"
                        widget="percentage"
                    />
                        <field
                        name="l10n_pt_overtime_holidays_rate_100"
                        string="Overtime Holidays"
                        widget="percentage"
                    />
                        <field
                        name="l10n_pt_overtime_saturday_and_holidays_rate_100"
                        string="Overtime Saturday and Holidays"
                        widget="percentage"
                    />
                        <field
                        name="l10n_pt_overtime_sunday_rate_100"
                        string="Overtime Sunday"
                        widget="percentage"
                    />
                    </group>
                    <group string="Night Overtime" invisible="country_code != 'PT'">
                        <field
                        name="l10n_pt_night_overtime_first_hour_rate"
                        string="Overtime First Hour"
                        widget="percentage"
                    />
                    <field
                        name="l10n_pt_night_overtime_remaining_hours_rate"
                        string="Overtime Remaining Hours"
                        widget="percentage"
                    />
                    <field
                        name="l10n_pt_night_overtime_rest_days_rate"
                        string="Overtime Rest Days"
                        widget="percentage"
                    />
                    <field
                        name="l10n_pt_night_overtime_workdays_rate"
                        string="Overtime Workdays"
                        widget="percentage"
                    />
                    <field
                        name="l10n_pt_night_overtime_holidays_rate"
                        string="Overtime Holidays"
                        widget="percentage"
                    />
                    <field
                        name="l10n_pt_night_overtime_saturday_and_holidays_rate"
                        string="Overtime Saturday and Holidays"
                        widget="percentage"
                    />
                    <field
                        name="l10n_pt_night_overtime_sunday_rate"
                        string="Overtime Sunday"
                        widget="percentage"
                    />
                </group>
                <group string="Night Work" invisible="country_code != 'PT'">
                    <field
                        name="l10n_pt_night_work_rate"
                        string="Night Work"
                        widget="percentage"
                    />
                </group>
                <group string="Other Allowances" invisible="country_code != 'PT'">
                    <label for="l10n_pt_diuturnities" widget="monetary" />
                    <div class="o_row">
                        <field name="l10n_pt_diuturnities" widget="monetary" />
                        <span>/ month</span>
                    </div>
                    <label for="l10n_pt_failures_allowance" />
                    <div class="o_row">
                        <field name="l10n_pt_failures_allowance" widget="monetary" />
                        <span>/ month</span>
                    </div>
                    <field
                        name="l10n_pt_work_schedule_exemption_option"
                        string="Work Schedule Exemption"
                    />
                    <label
                        for="l10n_pt_work_schedule_exemption_value"
                        invisible="l10n_pt_work_schedule_exemption_option != 'value'"
                    />
                    <div
                        class="o_row"
                        invisible="l10n_pt_work_schedule_exemption_option != 'value'"
                    >
                        <field
                            name="l10n_pt_work_schedule_exemption_value"
                            widget="monetary"
                        />
                        <span>/ month</span>
                    </div>
                    <label
                        for="l10n_pt_work_schedule_exemption_rate"
                        invisible="l10n_pt_work_schedule_exemption_option != 'rate'"
                    />
                    <div
                        class="o_row"
                        invisible="l10n_pt_work_schedule_exemption_option != 'rate'"
                    >
                        <field
                            name="l10n_pt_work_schedule_exemption_rate"
                            widget="percentage"
                        />
                        <span>/ month</span>
                    </div>
                    <field name="l10n_pt_shift_regime_option" string="Shift Regime" />
                    <label
                        for="l10n_pt_shift_regime_rate"
                        invisible="l10n_pt_shift_regime_option not in ['two_shift_regime', 'three_shift_regime', 'four_shift_regime', 'five_shift_regime']"
                    />
                    <div
                        class="o_row"
                        invisible="l10n_pt_shift_regime_option not in ['two_shift_regime', 'three_shift_regime', 'four_shift_regime', 'five_shift_regime']"
                    >
                        <field name="l10n_pt_shift_regime_rate" widget="percentage" />
                        <span>/ month</span>
                    </div>
                </group>
                <group string="Travel and Per Diems" invisible="country_code != 'PT'">
                    <label for="l10n_pt_value_per_km_in_own_vehicle" />
                    <div class="o_row">
                        <field
                            name="l10n_pt_value_per_km_in_own_vehicle"
                            widget="monetary"
                        />
                        <span>/ Km</span>
                    </div>
                    <label for="l10n_pt_value_per_km_in_public_transport" />
                    <div class="o_row">
                        <field
                            name="l10n_pt_value_per_km_in_public_transport"
                            widget="monetary"
                        />
                        <span>/ Km</span>
                    </div>
                    <field name="l10n_pt_per_diem_national" widget="monetary" />
                    <field name="l10n_pt_per_diem_international" widget="monetary" />
                    <label for="l10n_pt_travel_allowance" widget="monetary" />
                    <div class="o_row">
                        <field name="l10n_pt_travel_allowance" widget="monetary" />
                        <span>/ day</span>
                    </div>
                </group>
                <group string="Work Expenses" invisible="country_code != 'PT'">
                    <label
                        for="l10n_pt_remote_work_expense_electricity"
                        widget="monetary"
                    />
                    <div class="o_row">
                        <field
                            name="l10n_pt_remote_work_expense_electricity"
                            widget="monetary"
                        />
                        <span>/ day</span>
                    </div>
                    <label
                        for="l10n_pt_remote_work_expense_internet"
                        widget="monetary"
                    />
                    <div class="o_row">
                        <field
                            name="l10n_pt_remote_work_expense_internet"
                            widget="monetary"
                        />
                        <span>/ day</span>
                    </div>
                    <label
                        for="l10n_pt_remote_work_expense_computer_equipment"
                        widget="monetary"
                    />
                    <div class="o_row">
                        <field
                            name="l10n_pt_remote_work_expense_computer_equipment"
                            widget="monetary"
                        />
                        <span>/ day</span>
                    </div>
                </group>
            </xpath>
            <field name="date_start" position="before">
                <field
                    name="l10n_pt_first_contract_date"
                    invisible="country_code != 'PT'"
                />
            </field>
            <field name="hr_responsible_id" position="before">
                <field
                    name="l10n_pt_contract_type_ru"
                    invisible="country_code != 'PT'"
                />
            </field>
        </field>
    </record>

    <!-- Every information period of the worker's contracts at Social
         Security (opened grouped by contract from the contract form). -->
    <record id="l10n_pt_scc_ss_contract_view_list" model="ir.ui.view">
        <field name="name">l10n_pt.scc.ss.contract.list</field>
        <field name="model">l10n_pt.scc.ss.contract</field>
        <field name="arch" type="xml">
            <tree create="0" delete="0" edit="0">
                <field name="start_date" />
                <field name="end_date" />
                <field name="modality" />
                <field name="reason" optional="show" />
                <field name="information_start_date" />
                <field name="information_end_date" />
                <field name="base_remuneration" />
                <field name="currency_id" column_invisible="1" />
                <field name="is_current_period" optional="show" />
                <field name="profession" optional="hide" />
                <field name="provision_of_work" optional="hide" />
                <field name="work_percentage" optional="hide" />
                <field name="weekly_hours" optional="hide" />
                <field name="work_days" optional="hide" />
            </tree>
        </field>
    </record>
</odoo>
