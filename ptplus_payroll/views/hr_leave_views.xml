<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_leave_view_form_manager" model="ir.ui.view">
        <field name="name">hr.leave.view.form.manager.inherit.ptplus.payroll</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_payroll_holidays.hr_leave_view_form_inherit" />
        <field name="arch" type="xml">
            <!-- Portuguese companies deduct the time off in the next payslip with
                 the "Assiduidade (mês anterior)" input instead. -->
            <button name="action_report_to_next_month" position="attributes">
                <attribute
                    name="invisible"
                    add="l10n_pt_country_code == 'PT'"
                    separator=" or "
                />
            </button>
            <field name="payslip_state" position="after">
                <field name="l10n_pt_country_code" invisible="1" />
            </field>
        </field>
    </record>
</odoo>
