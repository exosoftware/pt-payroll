<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_hr_employee_grade_form_pt" model="ir.ui.view">
        <field name="name">hr.payroll.structure.form.pt</field>
        <field name="model">hr.payroll.structure</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_employee_grade_form" />
        <field name="arch" type="xml">
            <field name="active" position="after">
                <field name="country_code" invisible="1" />
            </field>
            <field name="use_worked_day_lines" position="attributes">
                <attribute name="readonly">country_code == 'PT'</attribute>
            </field>
            <field name="use_worked_day_lines" position="after">
                <field
                    name="l10n_pt_display_worked_days_table"
                    invisible="country_code != 'PT'"
                />
            </field>
        </field>
    </record>
</odoo>
