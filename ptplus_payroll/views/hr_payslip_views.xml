<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="employee_send_email_button_view_pt" model="ir.ui.view">
        <field name="name">employee.send.email.button.view</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <field name="salary_complement_count" invisible="1" />
                <field name="l10n_pt_same_reference_month_count" invisible="1" />
                <field name="l10n_pt_attachment_count" invisible="1" />
                <button
                    type="object"
                    class="oe_stat_button"
                    name="action_open_salary_complements"
                    id="open_salary_complements"
                    icon="content_copy"
                    invisible="country_code != 'PT' or not salary_complement_count"
                >
                    <field
                        name="salary_complement_count"
                        widget="statinfo"
                        string="Salary Complements"
                        invisible="country_code != 'PT'"
                    />
                </button>
                <button
                    type="object"
                    class="oe_stat_button"
                    name="action_slips_from_the_same_reference_month"
                    id="open_slips_from_the_same_reference_month"
                    icon="content_copy"
                    invisible="country_code != 'PT' or l10n_pt_same_reference_month_count in [0,1]"
                >
                    <field
                        name="l10n_pt_same_reference_month_count"
                        widget="statinfo"
                        string="Reference Period Slips"
                    />
                </button>
                <button
                    name="action_open_attachments"
                    type="object"
                    class="oe_stat_button"
                    icon="gavel"
                    invisible="l10n_pt_attachment_count == 0"
                >
                    <field
                        name="l10n_pt_attachment_count"
                        widget="statinfo"
                        string="Attachments"
                    />
                </button>
            </div>
            <button name="action_adjust_payslip" position="attributes">
                <attribute name="invisible" add="country_code == 'PT'" separator="or" />
            </button>
            <field name="version_id" position="after">
                <field name="l10n_pt_different_months" invisible="1" />
                <field
                    name="l10n_pt_payslip_type"
                    readonly="l10n_pt_payslip_type != 'normal'"
                    invisible="country_code != 'PT' or l10n_pt_payslip_type == 'normal'"
                />
                <field
                    name="l10n_pt_reference_period"
                    invisible="country_code != 'PT' or not l10n_pt_different_months"
                />
            </field>
            <field name="struct_id" position="after">
                <field
                    name="l10n_pt_previous_payslip_id"
                    invisible="not l10n_pt_previous_payslip_id"
                />
                <field
                    name="l10n_pt_after_payslip_id"
                    invisible="not l10n_pt_after_payslip_id"
                />
                <field
                    name="l10n_pt_independent_slip"
                    readonly="state not in ['draft']"
                />
            </field>
            <xpath
                expr="//field[@name='line_ids']/list/field[@name='total']"
                position="after"
            >
                <field
                    name="l10n_pt_amount_subject_to_ss"
                    readonly="1"
                    force_save="1"
                    optional="hide"
                />
                <field
                    name="l10n_pt_amount_subject_to_it"
                    readonly="1"
                    force_save="1"
                    optional="hide"
                />
                <field
                    name="l10n_pt_amount_exempt_to_it"
                    readonly="1"
                    force_save="1"
                    optional="hide"
                />
            </xpath>
            <xpath
                expr="//field[@name='input_line_ids']/kanban/field[@name='name']"
                position="after"
            >
                <field name="salary_complement_pt_id" />
            </xpath>
        </field>
    </record>

    <record id="hr_payslip_run_view_form_pt" model="ir.ui.view">
        <field name="name">hr.payslip.run.inherit.form.pt</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="hr_payroll.hr_payslip_run_form" />
        <field name="arch" type="xml">
            <field name="company_id" position="before">
                <field name="country_code" invisible="1" />
                <field name="l10n_pt_different_months" invisible="1" />
                <field
                    name="l10n_pt_reference_period"
                    invisible="country_code != 'PT' or not l10n_pt_different_months"
                />
                <field name="l10n_pt_independent_slip" />
            </field>
        </field>
    </record>

    <record id="action_reset_salary_complements" model="ir.actions.server">
        <field name="name">Reset Salary Complements</field>
        <field name="model_id" ref="hr_payroll.model_hr_payslip" />
        <field name="binding_model_id" ref="hr_payroll.model_hr_payslip" />
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">
        if records:
            records.action_reset_salary_complements()
        </field>
    </record>
</odoo>
