<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_pt_income_stmt_wizard_form" model="ir.ui.view">
        <field name="name">l10n_pt.payroll.income.stmt.wizard.form</field>
        <field name="model">l10n_pt.payroll.income.stmt.wizard</field>
        <field name="inherit_id" ref="ptplus_reports.l10n_pt_statement_wizard_form" />
        <field name="type">form</field>
        <field name="arch" type="xml">
            <group name="main_left" position="inside">
                <field
                    name="employee_ids"
                    widget="many2many_tags"
                    readonly="state != 'select'"
                />
            </group>
            <notebook name="main_block" position="inside">
                <page name="income_stmt_lines" string="Linhas">
                    <field name="income_stmt_line_ids" nolabel="1" readonly="1">
                        <list create="0" delete="0">
                            <field name="employee_id" />
                            <field name="income_category" />
                            <field name="salary_rule_description" />
                            <field name="income_amount" />
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

    <record id="l10n_pt_income_stmt_wizard_action" model="ir.actions.act_window">
        <field name="name">Declaração Anual de Rendimentos</field>
        <field name="res_model">l10n_pt.payroll.income.stmt.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="l10n_pt_income_stmt_wizard_form" />
        <field name="target">new</field>
    </record>

    <menuitem
        id="l10n_pt_income_stmt_wizard_menu"
        name="Declaração Anual de Rendimentos"
        parent="payroll_menu_report_pt"
        sequence="70"
        groups="hr_payroll.group_hr_payroll_user"
        action="l10n_pt_income_stmt_wizard_action"
    />
</odoo>
