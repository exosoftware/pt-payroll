<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_pt_holiday_sheets_wizard_form" model="ir.ui.view">
        <field name="name">l10n_pt.holiday.sheets.wizard.form</field>
        <field name="model">l10n_pt.holiday.sheets.wizard</field>
        <field name="inherit_id" ref="ptplus_reports.l10n_pt_statement_wizard_form" />
        <field name="type">form</field>
        <field name="arch" type="xml">
            <group name="main_left" position="inside">
                <field name="l10n_pt_insurance" readonly="state != 'select'" />
            </group>
            <notebook name="main_block" position="inside">
                <page name="lines" string="Lines">
                    <field name="line_ids" nolabel="1">
                        <list>
                            <field name="currency_id" column_invisible="1" />
                            <field name="record_type" />
                            <field name="raw_line" />
                            <field name="employee_id" optional="show" />
                            <field name="establishment_code" optional="show" />
                            <field name="reference_month" optional="show" />
                            <field name="remuneration_code" optional="show" />
                            <field name="worked_days" sum="Total" optional="show" />
                            <field name="amount" sum="Total" optional="show" />
                            <field name="social_security_number" optional="hide" />
                            <field name="birth_date" optional="hide" />
                            <field name="profession_code" optional="hide" />
                            <field name="insurance_company_code" optional="hide" />
                            <field name="insurance_policy_number" optional="hide" />
                            <field
                                name="company_social_security_number"
                                optional="hide"
                            />
                            <field name="company_vat" optional="hide" />
                            <field name="company_name" optional="hide" />
                            <field
                                name="total_contributions"
                                sum="Total"
                                optional="hide"
                            />
                            <field name="tax_rate" optional="hide" />
                            <field name="record_count" optional="hide" />
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

    <record id="l10n_pt_holiday_sheets_wizard_action" model="ir.actions.act_window">
        <field name="name">Holiday Sheets</field>
        <field name="res_model">l10n_pt.holiday.sheets.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="l10n_pt_holiday_sheets_wizard_form" />
        <field name="target">new</field>
    </record>

    <menuitem
        id="l10n_pt_holiday_sheets_wizard_menu"
        name="Holiday Sheets"
        parent="payroll_menu_report_pt"
        sequence="28"
        groups="ptplus.group_experimental_features_pt"
        action="l10n_pt_holiday_sheets_wizard_action"
    />
</odoo>
