<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="action_report_annual_income_stmt_pt" model="ir.actions.report">
        <field name="name">Income Statement</field>
        <field name="model">hr.employee</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ptplus_payroll.report_annual_income_stmt_pt</field>
        <field name="report_file">ptplus_payroll.report_annual_income_stmt_pt</field>
        <field
            name="print_report_name"
        >'Income Statement %s - %s' % (date_to.year if date_to else '', object.name)</field>
    </record>

    <template id="report_annual_income_stmt_pt" name="Annual Income Statement">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <t
                            t-set="marital_status"
                            t-value="o._pt_get_marital_status()"
                        />
                        <t t-if="marital_status == 'not_married_pt'">
                            <t t-set="marital_status" t-value="'solteiro(a)'" />
                        </t>
                        <t t-elif="marital_status == 'married_one_holder_pt'">
                            <t
                                t-set="marital_status"
                                t-value="'casado(a) um titular'"
                            />
                        </t>
                        <t t-else="">
                            <t
                                t-set="marital_status"
                                t-value="'casado(a) dois titulares'"
                            />
                        </t>

                        <t t-if="o.slip_ids">
                            <div style="page-break-after: always;">
                                <p>
                                Nos termos do nº 1, alinea b) do art. 119º, do CIRS, <span
                                        t-esc="o.l10n_pt_full_name"
                                    />, com residência em <span
                                        t-esc="o.private_street"
                                    />,
                                contribuinte nº <span t-esc="o.l10n_pt_vat" />, <span
                                        t-esc="marital_status"
                                    />, com <span
                                        t-esc="o.children"
                                    /> dependente/s, auferiu
                                <t t-if="date_from">, no ano de <span
                                            t-esc="date_from.year"
                                        /></t>
                                , os seguintes rendimentos relativos a trabalho dependente - Categoria A:
                            </p>
                                <t
                                    t-set="amounts"
                                    t-value="o.get_income_for_employee(date_from, date_to)"
                                />
                                <t t-set="exempts_it" t-value="amounts['exempts_it']" />
                                <t
                                    t-set="subjects_it"
                                    t-value="amounts['subjects_it']"
                                />
                                <t
                                    t-set="subject_to_tax"
                                    t-value="amounts['subject_to_tax']"
                                />

                                <p>
                                    <strong
                                    >Total de Rendimentos Ilíquidos Sujeitos referentes a
                                    <t t-if="date_from">
                                        <span t-esc="date_from.year" />
                                    </t> <br />
                                    <t
                                            t-esc="sum(subjects_it.values())"
                                            t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'
                                        />
                                </strong>
                                </p>
                                <t t-foreach="subjects_it.items()" t-as="s_it">
                                    <t t-set="rule" t-value="s_it[0]" />
                                    <t t-set="amount" t-value="s_it[1]" />
                                    <p style="margin-left: 25px;">
                                        <span
                                            t-esc="o._get_description_on_slip_str(rule)"
                                        />
                                        <br />
                                        <span
                                            t-esc="amount"
                                            t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'
                                        />
                                    </p>
                                </t>

                                <p>
                                    <strong
                                    >Total de Rendimentos Ilíquidos Não Sujeitos referentes a <t
                                            t-if="date_from"
                                        >
                                        <span t-esc="date_from.year" />
                                    </t> <br />
                                <t
                                            t-esc="sum(exempts_it.values())"
                                            t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'
                                        />
                                </strong>
                                </p>
                                <t t-foreach="exempts_it.items()" t-as="e_it">
                                    <t t-set="rule" t-value="e_it[0]" />
                                    <t t-set="amount" t-value="e_it[1]" />
                                    <p style="margin-left: 25px;">
                                        <span
                                            t-esc="o._get_description_on_slip_str(rule)"
                                        />
                                        <br />
                                        <span
                                            t-esc="amount"
                                            t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'
                                        />
                                    </p>
                                </t>

                                <p>
                                    <strong>
                                    Total de Descontos referentes a  <t
                                            t-if="date_from"
                                        >
                                        <span t-esc="date_from.year" />
                                    </t> <br />
                                    <t
                                            t-esc="abs(sum(subject_to_tax.values()))"
                                            t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'
                                        />
                                </strong>
                                </p>
                                <t t-foreach="subject_to_tax.items()" t-as="s_to_tax">
                                    <t t-set="rule" t-value="s_to_tax[0]" />
                                    <t t-set="amount" t-value="s_to_tax[1]" />
                                    <p style="margin-left: 25px;">
                                        <span
                                            t-esc="o._get_description_on_slip_str(rule)"
                                        />
                                        <br />
                                        <span
                                            t-esc="abs(amount)"
                                            t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'
                                        />
                                    </p>
                                </t>
                            </div>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
