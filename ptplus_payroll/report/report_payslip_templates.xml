<?xml version="1.0" encoding="utf-8" ?>
<odoo>
<template id="line_name">
    <t
            t-set="description_on_payslip"
            t-value="o.get_field_description_on_payslip(line)"
        />
    <t t-if="line.code == 'BASIC'">
        <t t-if="description_on_payslip == ''">
            <t t-if="o.employee_id.l10n_pt_intern == True">
                <span>Internship Grant</span>
            </t>
            <t t-else="">
                <span t-field="line.name" />
            </t>
        </t>
        <t t-elif="description_on_payslip != ''">
            <t t-if="o.employee_id.l10n_pt_intern == True">
                <span>Internship Grant</span>
            </t>
            <t t-else="">
                <span t-out="description_on_payslip" />
            </t>
        </t>
    </t>
    <t t-elif="line.code == 'IRS'">
        <t t-if="description_on_payslip == ''">
           <span t-field="line.name" />
        </t>
        <t t-elif="description_on_payslip != ''">
            <span t-field="line.name" />
        </t>
        <div style="font-size: 14px;">
            <!-- Normalize line sets -->
            <t t-set="lines" t-value="o.line_ids" />
            <t t-set="prev_lines" t-value="o.l10n_pt_previous_payslip_id.line_ids" />

            <!-- ========= BASIC SALARY ========= -->
            <t
                    t-set="basic_taxable_gross"
                    t-value="round(o.get_tax_sum_to_base(o, line_ids=lines), 2)"
                />

            <t
                    t-set="basic_tax_retained_current"
                    t-value="abs(lines.filtered(lambda l: l.code == 'IRS_SOMA_BASE').total)"
                />

            <t
                    t-set="basic_tax_retained_previous"
                    t-value="abs(prev_lines.filtered(lambda l: l.code == 'IRS_SOMA_BASE').total)"
                />

            <t
                    t-set="basic_tax_retained"
                    t-value="basic_tax_retained_current - basic_tax_retained_previous"
                />

            <!-- overtime adjustment for youth / return -->
            <t
                    t-set="overtime_taxable"
                    t-value="round(o.get_total_income_overtime(o, line_ids=lines), 2)"
                />

            <t
                    t-if="o.employee_id.pt_employee_has_youth_irs() or o.employee_id.pt_employee_has_return_program()"
                >
                <t
                        t-set="basic_taxable_gross"
                        t-value="basic_taxable_gross + overtime_taxable"
                    />
            </t>

            <t t-if="basic_taxable_gross">
                <span>
                    Basic Salary and Other Income: (Incidence:
                    <span
                            t-out="basic_taxable_gross"
                            t-options="{'widget': 'monetary','display_currency': o.company_id.currency_id}"
                        />
                    , TEMR:
                    <span
                            t-out="round(abs(basic_tax_retained / basic_taxable_gross * 100), 2) if basic_taxable_gross else 0"
                        /> %)
                </span>
            </t>

            <!-- ========= EXTRA HOURS ========= -->
            <t
                    t-set="overtime_taxable_current"
                    t-value="abs(lines.filtered(lambda l: l.code == 'IRS_HOR_EXTRA').amount)"
                />

            <t
                    t-set="overtime_taxable_previous"
                    t-value="abs(prev_lines.filtered(lambda l: l.code == 'IRS_HOR_EXTRA').amount)"
                />

            <t
                    t-set="overtime_taxable"
                    t-value="overtime_taxable_current - overtime_taxable_previous"
                />

            <t
                    t-set="overtime_tax_retained_current"
                    t-value="abs(lines.filtered(lambda l: l.code == 'IRS_HOR_EXTRA').total)"
                />

            <t
                    t-set="overtime_tax_retained_previous"
                    t-value="abs(prev_lines.filtered(lambda l: l.code == 'IRS_HOR_EXTRA').total)"
                />

            <t
                    t-set="overtime_tax_retained"
                    t-value="overtime_tax_retained_current - overtime_tax_retained_previous"
                />

            <t t-if="overtime_taxable">
                <br />
                <span>
                    Extra Hours: (Incidence:
                    <span
                            t-out="overtime_taxable"
                            t-options="{'widget': 'monetary','display_currency': o.company_id.currency_id}"
                        />
                    , TEMR:
                    <span
                            t-out="round(abs(overtime_tax_retained / overtime_taxable * 100), 2) if overtime_taxable else 0"
                        /> %)
                </span>
            </t>

            <!-- ========= HOLIDAY ALLOWANCE ========= -->
            <t
                    t-set="holiday_codes"
                    t-value="['SUBS_FER','SUBS_FER_DUO','SUBS_FER_DUO_50','SUBS_FER_50','SUBS_FER_PROP','SUBS_FER_ANOS_ANT']"
                />

            <t
                    t-set="holiday_tax_codes"
                    t-value="['SUBS_FER_TRIBUTADO','SUBS_FER_DUO_TRIBUTADO','SUBS_FER_DUO_50_TRIBUTADO','SUBS_FER_50_TRIBUTADO']"
                />

            <t
                    t-set="holiday_taxable_gross"
                    t-value="sum(lines.filtered(lambda l: l.code in holiday_codes).mapped('total')) or 0"
                />

            <t
                    t-set="holiday_taxable"
                    t-value="holiday_taxable_gross if o.employee_id.pt_employee_has_youth_irs() and holiday_taxable_gross else (sum(lines.filtered(lambda l: l.code in holiday_tax_codes).mapped('amount')) or 0)"
                />

            <t
                    t-set="holiday_tax_retained"
                    t-value="sum(lines.filtered(lambda l: l.code in holiday_tax_codes).mapped('total')) or 0"
                />

            <t t-if="holiday_taxable">
                <br />
                <span>
                    Holiday Allowance: (Incidence:
                    <span
                            t-out="holiday_taxable"
                            t-options="{'widget': 'monetary','display_currency': o.company_id.currency_id}"
                        />
                    , TEMR:
                    <span
                            t-out="round(abs(holiday_tax_retained / holiday_taxable * 100), 2)"
                        /> %)
                </span>
            </t>

            <!-- ========= CHRISTMAS ALLOWANCE ========= -->
            <t
                    t-set="christmas_codes"
                    t-value="['SUBS_NAT','SUBS_NAT_DUO','SUBS_NAT_DUO_50','SUBS_NAT_50','SUBS_NATAL_PROP']"
                />

            <t
                    t-set="christmas_tax_codes"
                    t-value="['SUBS_NAT_TRIBUTADO','SUBS_NAT_DUO_TRIBUTADO','SUBS_NAT_DUO_50_TRIBUTADO','SUBS_NAT_50_TRIBUTADO']"
                />

            <t
                    t-set="christmas_taxable_gross"
                    t-value="sum(lines.filtered(lambda l: l.code in christmas_codes).mapped('total')) or 0"
                />

            <t
                    t-set="christmas_taxable"
                    t-value="christmas_taxable_gross if o.employee_id.pt_employee_has_youth_irs() and christmas_taxable_gross else (sum(lines.filtered(lambda l: l.code in christmas_tax_codes).mapped('amount')) or 0)"
                />

            <t
                    t-set="christmas_tax_retained"
                    t-value="sum(lines.filtered(lambda l: l.code in christmas_tax_codes).mapped('total')) or 0"
                />

            <t t-if="christmas_taxable">
                <br />
                <span>
                    Christmas Allowance: (Incidence:
                    <span
                            t-out="christmas_taxable"
                            t-options="{'widget': 'monetary','display_currency': o.company_id.currency_id}"
                        />
                    , TEMR:
                    <span
                            t-out="round(abs(christmas_tax_retained / christmas_taxable * 100), 2)"
                        /> %)
                </span>
            </t>

            <!-- ========= GLOBAL BASIC SALARY ========= -->
            <t
                    t-set="global_basic_taxable"
                    t-value="o.line_ids.filtered(lambda l: l.code == 'IRS_SOMA_BASE_TRIBUTAVEL').total"
                />

            <t
                    t-set="global_basic_tax_retained"
                    t-value="abs(o.line_ids.filtered(lambda l: l.code == 'IRS_SOMA_BASE').total)"
                />

            <t t-if="global_basic_taxable and o.l10n_pt_previous_payslip_id">
                <br />
                <span>
                    Global Basic Salary and Other Income: (Incidence:
                    <span
                            t-out="global_basic_taxable"
                            t-options="{'widget': 'monetary','display_currency': o.company_id.currency_id}"
                        />
                    , TEMR:
                    <span
                            t-out="round(abs(global_basic_tax_retained / global_basic_taxable * 100), 2) if global_basic_taxable else 0"
                        /> %)
                </span>
            </t>

            <!-- ========= GLOBAL EXTRA HOURS ========= -->
            <t
                    t-set="global_overtime_line"
                    t-value="o.line_ids.filtered(lambda l: l.code == 'IRS_HOR_EXTRA')"
                />

            <t t-set="global_overtime_taxable" t-value="global_overtime_line.amount" />

            <t
                    t-set="global_overtime_tax_retained"
                    t-value="abs(global_overtime_line.total)"
                />

            <t t-if="global_overtime_taxable and o.l10n_pt_previous_payslip_id">
                <br />
                <span>
                    Global Extra Hours: (Incidence:
                    <span
                            t-out="global_overtime_taxable"
                            t-options="{'widget': 'monetary','display_currency': o.company_id.currency_id}"
                        />
                    , TEMR:
                    <span
                            t-out="round(abs(global_overtime_tax_retained / global_overtime_taxable * 100), 2) if global_overtime_taxable else 0"
                        /> %)
                </span>
            </t>

            <!-- ========= IRS DIFFERENTIAL ========= -->
            <t t-set="total_irs_last_slip" t-value="o.get_total_irs_last_slip(o)" />
            <t t-if="total_irs_last_slip">
                <br />
                <span>IRS differential:
                <span
                            t-out="line.total + total_irs_last_slip"
                            t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"
                        /> <span>(cumulative total)</span> +
                        <span
                            t-out="abs(total_irs_last_slip)"
                            t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"
                        /></span>
                    <span>(accumulated from the last payslips)</span>
                </t>
            </div>
        </t>

        <t t-elif="line.code == 'SS'">
            <t t-if="description_on_payslip == ''">
                <span><span t-field="line.name" /> (<span
                        t-field="o.employee_id.l10n_pt_employee_type_id.employee_tax_rate"
                    />%)</span>
            </t>
            <t t-elif="description_on_payslip != ''">
                <span><span t-out="description_on_payslip" /> (<span
                        t-field="o.employee_id.l10n_pt_employee_type_id.employee_tax_rate"
                    />%)</span>
            </t>
        </t>
        <t t-else="">
            <t t-if="description_on_payslip == ''">
                <span t-field="line.name" />
            </t>
            <t t-else="description_on_payslip != ''">
                <span t-out="description_on_payslip" />
            </t>
        </t>
    </template>

    <template id="report_slip_pt">
        <t t-call="web.external_layout">
            <t
                t-set="o"
                t-value="o.with_context(lang=o.employee_id.lang or o.env.lang)"
            />
                    <div class="page">
                        <h2 style="margin-bottom: 0.5cm">Payslip</h2>
                        <t t-set="is_invalid" t-value="o._is_invalid()" />
                        <t t-if="is_invalid">
                            <strong id="invalid_warning">
                                <t t-out="is_invalid" />
                            </strong>
                        </t>
                        <div id="employee_info">
                            <div style="width: 67%; float: left;">
                                <div style="width: 30%; float: left">
                                    <strong>Employee</strong>
                                </div>
                                <div style="width: 70%; float:Right">
                                    <span
                                t-esc="o.employee_id.l10n_pt_full_name or o.employee_id.name"
                            />
                                </div>
                                <div style="clear: both;" />
                                <div style="width: 30%; float: left">
                                    <strong>Profession</strong>
                                </div>
                                <div style="width: 70%; float:Right">
                                    <span
                                t-field="o.employee_id.l10n_pt_profession_id.name"
                            />
                                </div>
                                <div style="clear: both;" />
                                <div style="width: 30%; float: left">
                                    <strong>Professional Category</strong>
                                </div>
                                <div style="width: 70%; float:Right">
                                    <span
                                t-field="o.employee_id.l10n_pt_professional_category.name"
                            />
                                </div>
                                <div style="clear: both;" />
                                <div style="width: 30%; float: left">
                                    <strong>No. Beneficiary</strong>
                                </div>
                                <div style="width: 70%; float:Right">
                                    <span t-field="o.employee_id.ssnid" />
                                </div>
                                <div style="clear: both;" />
                                <div style="width: 30%; float: left">
                                    <strong>No. Identification</strong>
                                </div>
                                <div style="width: 70%; float:Right">
                                    <t
                                t-if="o.employee_id.l10n_pt_vat"
                                t-out="o.pt_get_employee_vat()"
                            />
                                </div>
                                <div style="clear: both;" />
                                <div style="width: 30%; float: left">
                                    <strong>Insurance</strong>
                                </div>
                                <div style="width: 70%; float:Right">
                                    <span>
                                        <span
                                    t-field="o.employee_id.l10n_pt_insurance_company_id"
                                /> insurance no
                                        <span
                                    t-field="o.employee_id.l10n_pt_insurance_policy_no"
                                />
                                    </span>
                                </div>
                                <div style="clear: both;" />
                                <div
                            style="width: 30%; float: left; margin-bottom: 0.8cm"
                        >
                                    <strong>Pay Period</strong>
                                </div>
                                <div style="width: 70%; float:Right">
                                    <span t-esc="o.get_slip_dates()[0]" />
                                    -
                                    <span t-esc="o.get_slip_dates()[1]" />
                                </div>
                                <div style="clear: both;" />
                            </div>
                            <div style="width: 33%; float: right;">
                                <div style="width: 70%; float: left">
                                    <strong>No. Employee</strong>
                                </div>
                                <div
                            style="width: 30%; float:Right; text-align: right;"
                        >
                                    <span t-esc="o.pt_get_no_employee()" />
                                </div>
                                <div style="clear: both;" />
                                <div style="width: 50%; float: left">
                                    <strong>Computed on </strong>
                                </div>
                                <div
                            style="width: 50%; float:Right; text-align: right;"
                        >
                                    <span t-esc="o.get_slip_dates()[2]" />
                                </div>
                                <div style="clear: both;" />
                                <div style="width: 55%; float: left;">
                                    <strong>Basic Salary</strong>
                                </div>
                                <div
                            style="width: 45%; float:Right; text-align: right;"
                        >
                                    <span
                                t-out="o.version_id._get_contract_wage()"
                                t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"
                            />
                                </div>
                                <div style="clear: both;" />
                                <div style="width: 50%; float: left">
                                    <strong>Hourly wage</strong>
                                </div>
                                <div
                            style="width: 50%; float:Right; text-align: right;"
                        >
                                    <span
                                t-out="o.line_ids.filtered(lambda line: line.code == 'SAL_HORA').total"
                                t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'
                            />
                                </div>
                                <div style="clear: both;" />
                                <div style="width: 75%; float: left">
                                    <strong>Working Schedule</strong>
                                </div>
                                <div
                            style="width: 25%; float:Right; text-align: right;"
                        >
                                    <span
                                t-field="o.version_id.resource_calendar_id.hours_per_week"
                            />
                                </div>
                                <div style="clear: both;" />
                            </div>
                        </div>

                        <div id="total" style="page-break-inside: auto !important;">
                            <table class="table table-sm">
                                <thead class="o_black_border">
                                    <tr style="text-align: left;">
                                        <th>Name</th>
                                        <th>Unit Value</th>
                                        <th>Quantity</th>
                                        <th style="text-align: right;">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <span
                                t-foreach="o.line_ids.filtered(
                                        lambda line:
                                            line.appears_on_payslip
                                            and (
                                                not o.l10n_pt_independent_slip
                                                or (line.quantity and line.amount)
                                            )
                                    )"
                                t-as="line"
                            >
                                        <t t-set="line_style" />
                                        <t t-set="line_class" />
                                        <t t-if="line.code == 'NET'">
                                            <t
                                        t-set="line_style"
                                        t-value="'color:#875A7B;'"
                                    />
                                            <t
                                        t-set="line_class"
                                        t-value="'o_total o_border_bottom fw-bold'"
                                    />
                                        </t>
                                        <t
                                    t-if="(line.code == 'BASIC') or (line.code == 'GROSS')"
                                >
                                            <t
                                        t-set="line_style"
                                        t-value="'color:#00A09D;'"
                                    />
                                            <t
                                        t-set="line_class"
                                        t-value="'o_subtotal o_border_bottom'"
                                    />
                                        </t>
                                        <tr
                                    t-att-class="line_class"
                                    t-att-style="line_style"
                                    id="line_display"
                                >
                                            <td>
                                                <t t-call="ptplus_payroll.line_name" />
                                            </td>
                                            <td>
                                                <t
                                            t-if="'FALTA' in line.code or 'FERIAS' in line.code"
                                        >
                                                    <span />
                                                </t>
                                                <t t-else="">
                                                    <t t-if="line.quantity > 1">
                                                        <t
                                                    t-set="unit_value"
                                                    t-value="line.total / line.quantity"
                                                />
                                                        <span
                                                    t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"
                                                    t-out="unit_value"
                                                />
                                                    </t>

                                                    <t t-else="">
                                                        <span />
                                                    </t>
                                                </t>
                                            </td>
                                            <td>
                                                <t
                                            t-if="'FALTA' in line.code or 'FERIAS' in line.code"
                                        >
                                                    <t
                                                t-set="number_of_days"
                                                t-value="o.worked_days_line_ids.filtered(lambda wor_day_line: wor_day_line.code == line.code).number_of_days"
                                            />
                                                    <span t-out='number_of_days' />
                                                </t>
                                                <t t-else="">
                                                    <span
                                                t-if="line.quantity >= 1"
                                                t-out="line.quantity"
                                            />
                                                </t>
                                            </td>
                                            <td style="text-align: right;">
                                                <t t-if="line.code == 'IRS'">
                                                    <t
                                                t-set="irs_total"
                                                t-value="line.total"
                                            />
                                                    <span
                                                t-esc="irs_total"
                                                t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'
                                                t-att-style="'color:#875A7B;' if line.total &lt; 0 else ''"
                                            />
                                                </t>
                                                <t t-elif="line.code == 'NET'">
                                                    <t
                                                t-set="total_net_amount"
                                                t-value="o.get_total_net_amount(o.line_ids)"
                                            />
                                                    <span
                                                t-esc="total_net_amount"
                                                t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'
                                                t-att-style="'color:#875A7B;' if line.total &lt; 0 else ''"
                                            />
                                                </t>
                                                <t t-else="">
                                                    <span
                                                t-out="line.total"
                                                t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'
                                                t-att-style="'color:#875A7B;' if line.total &lt; 0 else ''"
                                            />
                                                </t>
                                            </td>
                                        </tr>
                                    </span>
                                </tbody>
                            </table>
                        </div>

                        <div id="to_pay">
                            <t t-if="o.net_wage &gt;= 0">
                                <t
                            t-set="total_irs_last_slip"
                            t-value="o.get_total_irs_last_slip(o)"
                        />
                                <t
                            t-set="total_irs"
                            t-value="o.line_ids.filtered(lambda line: line.code == 'IRS').total"
                        />
                                <p
                            t-if="total_irs_last_slip"
                            style="font-size: 12px; margin-left: 15px"
                        >
                                    The accumulated amount of income tax withheld from the various payslips for the month of processing is
                                    <span
                                t-out="abs(total_irs + total_irs_last_slip)"
                                t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"
                            />
                                    .
                                </p>

                                <t
                            t-set="total_receivable_in_bank"
                            t-value="o.line_ids.filtered(lambda line: line.code == 'NET').total"
                        />
                                <t t-if="total_receivable_in_bank">
                                    <p>The amount of <span
                                    t-out='total_receivable_in_bank'
                                    t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'
                                /> was paid by bank transfer.</p>
                                </t>
                                <t
                            t-set="total_in_kind"
                            t-value="o.line_ids.filtered(lambda line: line.code == 'T_RECEBER_ESP').total"
                        />
                                <t t-if="total_in_kind">
                                    <p>
                                        The amount of <span
                                    t-out="total_in_kind"
                                    t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'
                                /> was paid in kind.
                                    </p>
                                </t>
                                <t
                            t-if="o.line_ids.filtered(lambda line: line.code == 'T_RECEBER_TIC') and o.line_ids.filtered(lambda line: line.code == 'T_RECEBER_TIC').total"
                        >
                                    <t
                                t-set="subs_ref_tic"
                                t-value="o.line_ids.filtered(lambda line: line.code == 'T_RECEBER_TIC').total"
                            />
                                    <p>The amount of <span
                                    t-out="subs_ref_tic"
                                    t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'
                                /> was paid by meal Ticket/Card.
                                    </p>
                                </t>
                                <t
                            t-set="allocations"
                            t-value="o.compute_salary_allocations()"
                        />
                                <p t-foreach="allocations.items()" t-as="alloc">
                                    <t
                                t-set="bank"
                                t-value="o.employee_id.bank_account_ids.filtered(lambda b: str(b.id) == alloc[0])[0]"
                            />
                                    To pay on
                                    <span
                                class="fw-bold"
                                t-esc="bank.acc_number or 'N/A'"
                            />
                                    of <span
                                class="fst-italic"
                                t-field="o.employee_id.legal_name"
                            />:

                                    <span
                                t-esc="alloc[1]"
                                class="fw-bold"
                                t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                            />
                                </p>
                                <t t-if="not allocations">
                                    Amount to be paid to <span
                                class="fst-italic"
                                t-field="o.employee_id.legal_name"
                            />: <span
                                t-esc="o.net_wage"
                                t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                class="fw-bold"
                            />
                                </t>
                            </t>
                            <p t-if="o.net_wage &lt; 0">
                                The net amount will be recovered from the first positive remuneration established after this.
                            </p>
                        </div>
                    </div>
                </t>
    </template>

