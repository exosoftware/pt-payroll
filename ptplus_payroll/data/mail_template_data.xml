<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">

    <record id="email_template_income_statement" model="mail.template">
        <field name="name">Employee Income Statement</field>
        <field name="model_id" ref="hr.model_hr_employee" />
        <field name="subject">Annual Income Statement</field>
        <field name="email_from">{{ object.company_id.email }}</field>
        <field name="email_to">{{ object.private_email }}</field>
        <field name="body_html" type="html">
            <div
                style="font-family: 'Lucica Grande', Ubuntu, Arial, Verdana, sans-serif; font-size: 12px; color: rgb(34, 34, 34); background-color: #FFF; "
            >
                <p>Olá Caro(a) <t t-out="object.name" />,</p>
                <p>Por favor, encontre em anexo a sua Declaração Anual de Rendimentos,
                    relativo à empresa <t t-out="object.company_id.name" />.</p>

                <p>Se tiver alguma dúvida, não hesite em contactar o RH.</p><br />
                <p>Obrigado(a).</p>
                <p>Departamento de RH.</p>
                <p><t t-out="object.company_id.name" /></p>
            </div>
        </field>
    </record>

    <record id="email_template_income_statement_wizard" model="mail.template">
        <field name="name">Employee Income Statement (Wizard)</field>
        <field
            name="model_id"
            ref="ptplus_payroll.model_l10n_pt_payroll_income_stmt_wizard"
        />
        <field name="subject">Annual Income Statement</field>
        <field name="email_from">{{ object.company_id.email }}</field>
        <field name="email_to">{{ ctx.get('employee').private_email }}</field>
        <field
            name="report_template_ids"
            eval="[(4, ref('action_report_income_stmt_wizard_pt'))]"
        />
        <field name="body_html" type="html">
            <div
                style="font-family: 'Lucica Grande', Ubuntu, Arial, Verdana, sans-serif; font-size: 12px; color: rgb(34, 34, 34); background-color: #FFF; "
            >
                <p>Olá Caro(a) <t t-out="ctx.get('employee').name" />,</p>
                <p>Por favor, encontre em anexo a sua Declaração Anual de Rendimentos,
                    relativo à empresa <t t-out="object.company_id.name" />, com o
                    detalhe de todas as rubricas de rendimento e desconto
                    consideradas.</p>

                <p>Se tiver alguma dúvida, não hesite em contactar o RH.</p><br />
                <p>Obrigado(a).</p>
                <p>Departamento de RH.</p>
                <p><t t-out="object.company_id.name" /></p>
            </div>
        </field>
    </record>

</odoo>
