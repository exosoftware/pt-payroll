#. module: ptplus_hr_recruitment_sapo
#: model_terms:ir.ui.view,arch_db:ptplus_hr_recruitment_sapo.hr_recruitment_post_job_wizard_view_form_sapo
msgid ""
"<span>These describe the advert on SAPO Emprego. They come back filled "
"from the last advert published for this job position, and clearing one of "
"the last four takes its section off the advert.</span>"
msgstr ""
"<span>Estes descrevem o anúncio no SAPO Emprego. Voltam preenchidos a "
"partir do último anúncio publicado desta posição, e esvaziar um dos "
"quatro últimos retira a sua secção do anúncio.</span>"

#. module: ptplus_hr_recruitment_sapo
#: model_terms:ir.ui.view,arch_db:ptplus_hr_recruitment_sapo.hr_job_post_view_form_sapo
msgid ""
"<span>This is how SAPO Emprego files the advert. Use Update to send a "
"change to the platform.</span>"
msgstr ""
"<span>É assim que o SAPO Emprego classifica o anúncio. Use Atualizar para "
"enviar uma alteração para a plataforma.</span>"

#. module: ptplus_hr_recruitment_sapo
#: model_terms:ir.ui.view,arch_db:ptplus_hr_recruitment_sapo.res_config_settings_view_form_sapo
msgid ""
"<span>Without a premium service, candidates apply on SAPO Emprego itself "
"and each application is mailed to the email alias of the job "
"position.</span>"
msgstr ""
"<span>Sem serviço premium, os candidatos candidatam-se no próprio SAPO "
"Emprego e cada candidatura é enviada por email para o alias da "
"posição.</span>"

