#. module: ptplus_hr_recruitment_sapo
#: model:ir.model.fields,help:ptplus_hr_recruitment_sapo.field_hr_job_post__l10n_pt_sapo_offer
#: model:ir.model.fields,help:ptplus_hr_recruitment_sapo.field_hr_recruitment_post_job_wizard__l10n_pt_sapo_offer
msgid ""
"What the company offers, one benefit per line. Fills the 'Oferta' section "
"of the advert."
msgstr ""
"O que a empresa oferece, um benefício por linha. Preenche a secção "
"'Oferta' do anúncio."

#. module: ptplus_hr_recruitment_sapo
#: model_terms:ir.ui.view,arch_db:ptplus_hr_recruitment_sapo.hr_job_post_view_form_sapo
#: model_terms:ir.ui.view,arch_db:ptplus_hr_recruitment_sapo.hr_recruitment_post_job_wizard_view_form_sapo
