<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="ptplus_netempregos_code_view_list" model="ir.ui.view">
        <field name="name">ptplus.netempregos.code.list</field>
        <field name="model">ptplus.netempregos.code</field>
        <field name="arch" type="xml">
            <list string="Net-Empregos Codes" editable="bottom">
                <field name="code_type" />
                <field name="code" />
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="ptplus_netempregos_code_view_search" model="ir.ui.view">
        <field name="name">ptplus.netempregos.code.search</field>
        <field name="model">ptplus.netempregos.code</field>
        <field name="arch" type="xml">
            <search string="Net-Empregos Codes">
                <field name="name" />
                <field name="code" />
                <filter
                    name="filter_zone"
                    string="Zones"
                    domain="[('code_type', '=', 'zone')]"
                />
                <filter
                    name="filter_category"
                    string="Professional Categories"
                    domain="[('code_type', '=', 'category')]"
                />
                <filter
                    name="filter_job_type"
                    string="Job Types"
                    domain="[('code_type', '=', 'job_type')]"
                />
                <separator />
                <filter
                    name="groupby_code_type"
                    string="List"
                    context="{'group_by': 'code_type'}"
                />
            </search>
        </field>
    </record>

    <record id="ptplus_netempregos_code_action" model="ir.actions.act_window">
        <field name="name">Net-Empregos Codes</field>
        <field name="res_model">ptplus.netempregos.code</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_groupby_code_type': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Net-Empregos codes found
            </p>
            <p>
                These are the zones, professional categories and job types
                published by Net-Empregos. An offer is advertised under one of
                each.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_ptplus_netempregos_code"
        name="Net-Empregos Codes"
        parent="hr_recruitment.menu_hr_job_boards"
        action="ptplus_netempregos_code_action"
        sequence="60"
    />
</odoo>
