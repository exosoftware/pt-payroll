<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record
        id="hr_recruitment_post_job_wizard_view_form_netempregos"
        model="ir.ui.view"
    >
        <field name="name">hr.recruitment.post.job.wizard.form.netempregos</field>
        <field name="model">hr.recruitment.post.job.wizard</field>
        <field
            name="inherit_id"
            ref="hr_recruitment_integration_base.hr_recruitment_post_job_wizard_view_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <!-- The condition reads platform_ids directly, which the form
                     always carries. A helper field would have to be declared
                     inside this page to be loaded, and a page that is
                     invisible never instantiates its content: the field would
                     stay unknown and the page invisible for good. -->
                <page
                    name="netempregos"
                    string="Net-Empregos"
                    invisible="%(ptplus_hr_recruitment_netempregos.hr_recruitment_platform_netempregos)d not in platform_ids"
                >
                    <group>
                        <field
                            name="l10n_pt_netempregos_zone_id"
                            string="Zone"
                            options="{'no_create': True, 'no_open': True}"
                        />
                        <field
                            name="l10n_pt_netempregos_category_id"
                            string="Category"
                            options="{'no_create': True, 'no_open': True}"
                        />
                        <field
                            name="l10n_pt_netempregos_job_type_id"
                            string="Job Type"
                            options="{'no_create': True, 'no_open': True}"
                        />
                    </group>
                    <div class="text-muted">
                        <span
                        >Net-Empregos advertises the offer under these three. They come back filled from the last advert published for this job position.</span>
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
